# Modèle de configuration de l'assistant IA.
# 1. Copier ce fichier et le renommer en  .env.local
# 2. Coller votre clé à la place de  votre_cle_ici
# 3. Relancer  npm run dev
# Le fichier .env.local est ignoré par Git : la clé ne part jamais sur GitHub.

# Clé API (Google AI Studio : https://aistudio.google.com/apikey)
VITE_AI_API_KEY=votre_cle_ici

# Fournisseur : gemini (par défaut) ou groq (clé sur https://console.groq.com/keys)
VITE_AI_PROVIDER=gemini

# Modèle (facultatif). Par défaut : gemini-3.5-flash-lite (Gemini) ou openai/gpt-oss-20b (Groq)
# VITE_AI_MODEL=gemini-3.5-flash-lite
